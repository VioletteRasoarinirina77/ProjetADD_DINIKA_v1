# Copier ce fichier en ".env" (déjà ignoré par git) et remplir les vraies valeurs.
# Ne JAMAIS committer de vraies clés — exigence du DoD projet.

# URL de l'API de la Piste Data (pour récupérer les Bougies)
PISTE_DATA_API_URL=http://localhost:8001

# URL de l'API de la Piste IA (pour envoyer le Signal quantitatif)
PISTE_IA_API_URL=http://localhost:8003

# Source des données (mode d'exécution) :
#   dev  = fixtures locales (données SYNTHÉTIQUES, démonstration)
#   pack = pack gelé de la Piste Data (ES v1.0, SHA-256 vérifié avant tout calcul)
#   prod = API de la Piste Data (PISTE_DATA_API_URL)
ENVIRONMENT=dev

# Dossier du pack gelé (optionnel ; défaut : fixtures/integration/pack_es_v1 dans le dépôt)
# DINIKA_PACK_DIR=fixtures/integration/pack_es_v1
